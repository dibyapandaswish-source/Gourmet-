function lineChart(host,series,fmtY,title){
  const W=host.clientWidth||900, H=190, L=48, R=94, TP=14, B=30;
  const dates=DATA.dates, n=dates.length;
  const all=series.flatMap(s=>s.pts.filter(v=>v!=null));
