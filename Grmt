const P_NIGHT = ['Red Masala (CK)','Podi (CK)','Black Masala (CK)','Bhel Puri Mixture (CK)',
  'Masala Peanut (CK)','Papdi (CK)','Poha Mixture (CK)'];
const P_BAKERY = ['Brioche Bun 4" - GGN','Mumbai Pav - GGN','Sandwich Bread - GGN','Tutti Frutti Bun - GGN'];
const P_TODAY_CATS = ['Production In-house','F&V'];
const P_TERMINAL = ['closed','received','force_closed'];
const P_NCR_PREFIX = ['GGN','NOI','DEL','GZB'];

function pr2(x){ return Math.round(x*100)/100; }
function pToNum(v){ const n = typeof v==='string' ? parseFloat(v) : Number(v); return Number.isFinite(n) ? n : 0; }
function pDkey(s){ const [dd,mm,yy]=s.split('-'); return `${yy}-${mm}-${dd}`; }
function pPrevDay(s){
  const [dd,mm,yy]=s.split('-').map(Number);
  const dt=new Date(Date.UTC(yy,mm-1,dd)); dt.setUTCDate(dt.getUTCDate()-1);
  const p=n=>String(n).padStart(2,'0');
  return `${p(dt.getUTCDate())}-${p(dt.getUTCMonth()+1)}-${dt.getUTCFullYear()}`;
}
function pGroupBy(arr,keyFn){
  const m=new Map();
  for(const x of arr){ const k=keyFn(x); const g=m.get(k); if(g) g.push(x); else m.set(k,[x]); }
  return m;
}
const pK=(...parts)=>parts.join('::');

/** Minimal RFC4180 CSV parser — handles quoted fields with embedded commas,
 * newlines and doubled/escaped quotes, which the raw exports use (e.g. dates
 * like "Aug 5, 2026 1:45:36 PM"). Returns an array of row objects keyed by
 * the header row, same shape PapaParse's {header:true} would give us. */
function parseCSV(text){
  if(text.charCodeAt(0)===0xFEFF) text=text.slice(1);
  const rows=[]; let row=[], field='', inQuotes=false;
  for(let i=0;i<text.length;i++){
    const c=text[i];
    if(inQuotes){
      if(c==='"'){ if(text[i+1]==='"'){ field+='"'; i++; } else inQuotes=false; }
      else field+=c;
    } else {
      if(c==='"') inQuotes=true;
      else if(c===','){ row.push(field); field=''; }
      else if(c==='\r'){ /* skip, \n handles the line break */ }
      else if(c==='\n'){ row.push(field); rows.push(row); row=[]; field=''; }
      else field+=c;
    }
  }
  if(field.length || row.length){ row.push(field); rows.push(row); }
  if(!rows.length) return [];
  const header=rows[0], out=[];
  for(let r=1;r<rows.length;r++){
    if(rows[r].length===1 && rows[r][0]==='') continue;
    const obj={};
    for(let c=0;c<header.length;c++) obj[header[c]]=rows[r][c]!==undefined?rows[r][c]:'';
    out.push(obj);
  }
  return out;
}

function loadExportRows(csvText, filename){
  const parsed=parseCSV(csvText);
  if(parsed.length===0) return [];
  const fields=Object.keys(parsed[0]);
  for(const c of ['Ordered Quantity','Sent Quantity','Received Quantity']){
    if(!fields.includes(c)) throw new Error(`${filename}: missing column "${c}"`);
  }
  const out=[];
  for(const r of parsed){
    const pod=r['Internal Order From Location'], exp=r['Internal Order Expected Date'];
    if(!pod || !exp) continue;
    const prefix=pod.split('-')[0];
    const city = P_NCR_PREFIX.includes(prefix) ? 'NCR' : 'BLR';
    out.push({
      item:r['Product Full Name']||'', cat:r['Category']||'', uom:r['Unit Of Measure']||'',
      pod, status:r['Internal Order Status Name']||'', exp, io:r['Internal Order Number']||'',
      ord:pToNum(r['Ordered Quantity']), sent:pToNum(r['Sent Quantity']), recd:pToNum(r['Received Quantity']),
      city,
    });
  }
  return out;
}

function discoverReportDate(rows){
  let best=null;
  for(const r of rows){ if(!best || pDkey(r.exp)>pDkey(best)) best=r.exp; }
  if(!best) throw new Error('no usable rows (missing pod/expected-date on every line)');
  return best;
}

function dedupeReraised(rows){
  // Production In-house, both cities: originally a BLR-only CK re-raise
  // pattern, but from 25-08-2026 the same thing started happening for
  // NCR/Noida pods too, so this is no longer city-restricted.
  const groups=pGroupBy(rows.filter(r=>r.cat==='Production In-house'), r=>pK(r.item,r.pod));
  const drop=new Set();
  groups.forEach(g=>{
    if(g.length>1){
      const hasSent=g.some(r=>r.sent>0), hasZero=g.some(r=>r.sent===0);
      if(hasSent&&hasZero) g.filter(r=>r.sent===0).forEach(r=>drop.add(r));
    }
  });
  return rows.filter(r=>!drop.has(r));
}

// From this report date on, the source system stamps Expected Date the same
// day for every category (matching how Production In-house always worked) —
// no more D-1 lag for the other categories.
const P_SAME_DAY_FROM = '2026-08-21';

function applyDateRules(rows, D){
  const DM1=pPrevDay(D);
  const sameDayAll = pDkey(D) >= P_SAME_DAY_FROM;
  const want=r=>{
    if(sameDayAll || P_TODAY_CATS.includes(r.cat)) return (r.city==='BLR' && P_NIGHT.includes(r.item)) ? DM1 : D;
    if(r.city==='NCR' && P_BAKERY.includes(r.item)) return D;
    return DM1;
  };
  const filtered=rows.filter(r=>r.exp===want(r) && r.status!=='ordered')
    .map(r=>({...r, short:Math.max(r.ord-r.sent,0), terminal:P_TERMINAL.includes(r.status)}));
  return dedupeReraised(filtered);
}

function classifyPattern(sub){
  const n=sub.length, zero=sub.filter(s=>s.sent===0).length;
  const full=sub.filter(s=>s.fill!=null && s.fill>=0.995).length;
  const fills=sub.map(s=>s.fill).filter(f=>f!=null);
  let spread=0;
  if(n>1 && fills.length>1){
    const mean=fills.reduce((a,b)=>a+b,0)/fills.length;
    const variance=fills.reduce((a,b)=>a+(b-mean)**2,0)/(fills.length-1);
    spread=Math.sqrt(Math.max(variance,0));
  }
  if(!Number.isFinite(spread)) spread=0;
  const sentSum=sub.reduce((a,s)=>a+s.sent,0);
  let pat;
  if(sentSum===0) pat='total stock-out';
  else if(full===n) pat='fully supplied';
  else if(n<2) pat='single pod';
  else if(zero===0 && spread<0.12) pat='pro-rata cut';
  else pat='uneven';
  return {zero,full,spread,pat};
}

/** Build one report date's Agg — same shape as everything already in DATA.detail. */

/* ---------- build one report date from raw Internal Order rows ---------- */
/** item name -> tracked group, from the editable registry */
function registryMap(){
  const m={};
  GROUPS.forEach(g=>(DATA.registry[g]||[]).forEach(n=>{ m[n]=g; }));
  return m;
}

function buildDayAgg(D, framesRows){
  const raw=[].concat(...framesRows);
  const rows=applyDateRules(raw, D);              // same date/status rules + re-raise dedup
  const reg=registryMap();

  // every item name the file contained, so the tracked-items picker can offer them
  const catalog=[...new Set(raw.map(r=>r.item).filter(Boolean))].sort();

  const kept=rows.filter(r=>reg[r.item]);
  if(kept.length===0) return {date:D, pods:[], items:[], catalog};

  // item + store lines
  const lines=new Map();
  kept.forEach(r=>{
    const k=r.item+'\u0000'+r.uom+'\u0000'+r.pod;
    let x=lines.get(k);
    if(!x){ x={item:r.item, uom:r.uom, pod:r.pod, ord:0, sent:0, recd:0, ios:new Set()}; lines.set(k,x); }
    x.ord+=r.ord; x.sent+=r.sent; x.recd+=r.recd;
    if(r.io) x.ios.add(String(r.io).trim());
  });
  const all=[...lines.values()].filter(x=>x.ord>0);

  const pods=[...new Set(all.map(x=>x.pod))].sort();
  const pidx=new Map(pods.map((p,i)=>[p,i]));

  const byItem=new Map();
  all.forEach(x=>{
    const k=x.item+'\u0000'+x.uom;
    let g=byItem.get(k);
    if(!g){ g={i:x.item, u:x.uom, g:reg[x.item], rows:[]}; byItem.set(k,g); }
    g.rows.push(x);
  });

  const items=[...byItem.values()].map(g=>{
    const o=g.rows.reduce((a,x)=>a+x.ord,0);
    const s=g.rows.reduce((a,x)=>a+x.sent,0);
    const r=g.rows.reduce((a,x)=>a+x.recd,0);
    const sh=g.rows.reduce((a,x)=>a+Math.max(x.ord-x.sent,0),0);
    return {
      g:g.g, i:g.i, u:g.u,
      o:pr2(o), s:pr2(s), r:pr2(r), sh:pr2(sh),
      f:o?Math.round(s/o*10000)/10000:0,
      np:g.rows.length,
      z:g.rows.filter(x=>x.sent===0).length,
      pr:g.rows.map(x=>[pidx.get(x.pod), pr2(x.ord), pr2(x.sent), pr2(x.recd),
                        [...x.ios].sort().join(',')])
             .sort((a,b)=>(a[1]?a[2]/a[1]:9)-(b[1]?b[2]/b[1]:9))
    };
  }).sort((a,b)=>b.sh-a.sh);

  return {date:D, pods, items, catalog};
}

function mergeAggIntoData(agg){
  const D=agg.date;
  DATA.detail[D]={pods:agg.pods, items:agg.items};
  if(DATA.dates.indexOf(D)<0) DATA.dates.push(D);
  DATA.dates.sort((a,b)=> pDkey(a)<pDkey(b) ? -1 : pDkey(a)>pDkey(b) ? 1 : 0);
  if(agg.catalog && agg.catalog.length) DATA.catalog=agg.catalog;
}

/* =====================================================================
   Sales ingestion
   The sales export is whatever Metabase hands you, so nothing here assumes
   a fixed schema: columns are auto-detected, and anything ambiguous is put
   to the user instead of being guessed at.
   ===================================================================== */

const SALES_HINTS = {
  date: /^(business[\s_-]*date|order[\s_-]*date|sale[\s_-]*date|date|day)$/i,
  pod:  /(location|store|outlet|branch|pod|restaurant|kitchen|site)/i,
  item: /(product|item|sku|dish|menu)/i,
  qty:  /(qty|quantity|units?|sold|count)/i
};

/** Internal Order export, or a sales export? */
function looksLikeIO(fields){
  return fields.indexOf('Ordered Quantity')>=0 && fields.indexOf('Internal Order From Location')>=0;
}

function detectSalesCols(fields){
  const pick = re => fields.find(f=>re.test(String(f).trim())) || '';
  // prefer an exact-ish date column, else anything with "date" in it
  let date = pick(SALES_HINTS.date) || fields.find(f=>/date/i.test(f)) || '';
  // a quantity column that isn't an amount/value/price column
  const qtyCands = fields.filter(f=>SALES_HINTS.qty.test(f) && !/amount|value|price|total|revenue|sales?[\s_-]*value/i.test(f));
  const qty = qtyCands[0] || fields.find(f=>SALES_HINTS.qty.test(f)) || '';
  return {date, pod:pick(SALES_HINTS.pod), item:pick(SALES_HINTS.item), qty};
}

/** normalise an item name so CK indent names line up with menu/sales names */
function normName(s){
  return String(s||'')
    .toLowerCase()
    .replace(/\((?:gourmet\s*)?ck\)/g,' ')      // "(Gourmet CK)" / "(CK)"
    .replace(/-\s*gourmet\s*ck\b/g,' ')         // "- Gourmet CK"
    .replace(/-\s*ck\b/g,' ')                   // "- CK"
    .replace(/\(v\d*\)/g,' ')                   // "(V)" / "(V1)"
    .replace(/\b(rm|veg|non\s*veg)\b/g,' ')
    .replace(/[^a-z0-9]+/g,' ')
    .trim();
}

/** parse a sales CSV into {date, pod, item, qty} rows using the chosen columns */
function loadSalesRows(csvText, filename, cols){
  const parsed=parseCSV(csvText);
  if(!parsed.length) return [];
  const out=[];
  for(const r of parsed){
    const pod=String(r[cols.pod]||'').trim();
    const item=String(r[cols.item]||'').trim();
    if(!pod||!item) continue;
    const qty=pToNum(r[cols.qty]);
    const date=normaliseDate(String(r[cols.date]||'').trim());
    out.push({date, pod, item, qty});
  }
  return out;
}

/** accept dd-mm-yyyy, yyyy-mm-dd, dd/mm/yyyy and "Oct 7, 2026" style dates */
function normaliseDate(s){
  if(!s) return '';
  let m=s.match(/^(\d{2})-(\d{2})-(\d{4})/);            if(m) return `${m[1]}-${m[2]}-${m[3]}`;
  m=s.match(/^(\d{4})-(\d{2})-(\d{2})/);                if(m) return `${m[3]}-${m[2]}-${m[1]}`;
  m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);          if(m) return `${String(m[1]).padStart(2,'0')}-${String(m[2]).padStart(2,'0')}-${m[3]}`;
  const d=new Date(s);
  if(!isNaN(d.getTime())){
    const p=n=>String(n).padStart(2,'0');
    return `${p(d.getDate())}-${p(d.getMonth()+1)}-${d.getFullYear()}`;
  }
  return '';
}

/**
 * Fold sales rows into the stored dates.
 * Returns a report so the caller can tell the user exactly what matched and
 * what did not — a silent non-match would read as "sold nothing", which is
 * the one wrong answer this whole feature must never give.
 */
function attachSales(salesRows){
  const rep={dates:{}, matched:new Set(), unmatchedSales:new Set(), unmatchedPods:new Set(), noDate:0};

  // tracked item name -> normalised key, plus any manual aliases
  const tracked=[].concat(...GROUPS.map(g=>(DATA.registry[g]||[]).map(n=>n)));
  const byNorm=new Map();
  tracked.forEach(n=>{ const k=normName(n); if(!byNorm.has(k)) byNorm.set(k,n); });
  const alias=DATA.salesAlias||{};

  const resolve = salesItem => {
    if(alias[salesItem]) return alias[salesItem];
    const k=normName(salesItem);
    if(byNorm.has(k)) return byNorm.get(k);
    return null;
  };

  // bucket: date -> trackedItem -> pod -> qty
  const buckets=new Map();
  salesRows.forEach(r=>{
    if(!r.date){ rep.noDate++; return; }
    const t=resolve(r.item);
    if(!t){ rep.unmatchedSales.add(r.item); return; }
    rep.matched.add(r.item);
    if(!buckets.has(r.date)) buckets.set(r.date,new Map());
    const byItem=buckets.get(r.date);
    if(!byItem.has(t)) byItem.set(t,new Map());
    const byPod=byItem.get(t);
    byPod.set(r.pod,(byPod.get(r.pod)||0)+r.qty);
  });

  buckets.forEach((byItem,D)=>{
    const dd=DATA.detail[D];
    if(!dd){ rep.dates[D]={applied:0, note:'no indent data stored for this date'}; return; }
    const podSet=new Set(dd.pods);
    let applied=0;
    dd.items.forEach(i=>{
      const byPod=byItem.get(i.i);
      if(!byPod) return;
      const map={}; let tot=0;
      byPod.forEach((q,pod)=>{
        if(!podSet.has(pod)) rep.unmatchedPods.add(pod);
        map[pod]=pr2((map[pod]||0)+q); tot+=q;
      });
      i.soldBy=map; i.sold=pr2(tot); applied++;
    });
    // an item with sales data loaded but no rows at all genuinely sold zero
    dd.salesLoaded=true;
    dd.items.forEach(i=>{ if(i.sold==null && byItem.size){ i.sold=0; i.soldBy={}; } });
    rep.dates[D]={applied, items:dd.items.length};
  });
  return rep;
}

/** clear every sales figure (used when re-mapping names) */
function clearSales(){
  DATA.dates.forEach(D=>{
    const dd=DATA.detail[D]; if(!dd) return;
    delete dd.salesLoaded;
    dd.items.forEach(i=>{ delete i.sold; delete i.soldBy; });
  });
}

/* ---------- live / not-live check ---------- */
/**
 * For the current date and range, classify every item x store line.
 *   ok          sent and sold
 *   notselling  sent, but zero sold  -> the flag the user asked for
 *   unsold-nosend nothing sent, nothing sold
 *   nodata      no sales file loaded for this date
 */
function liveRows(){
  const d=det(); if(!d) return [];
  const loaded=!!d.salesLoaded;
  const out=[];
  itemsFor().forEach(i=>{
    (i.pr||[]).forEach(p=>{
      if(p[1]<=0) return;
      const pod=d.pods[p[0]];
      const sold=soldAt(i,pod);
      let state;
      if(!loaded || i.sold==null) state='nodata';
      else if(p[2]<=0) state = (sold>0) ? 'sold-not-sent' : 'unsold-nosend';
      else state = (sold>0) ? 'ok' : 'notselling';
      out.push({item:i.i, grp:i.g, pod, ord:p[1], sent:p[2], sold, state, io:p[4]});
    });
  });
  return out;
}

/* ---------- live check ---------- */
let liveView='flag';

const STATE_LABEL={
  ok:'selling', notselling:'indented, not selling',
  'sold-not-sent':'sold without a dispatch', 'unsold-nosend':'nothing sent, nothing sold',
  nodata:'no sales data'
};
const STATE_COLOR={
  ok:'var(--good)', notselling:'var(--critical)',
  'sold-not-sent':'var(--warning)', 'unsold-nosend':'var(--muted)', nodata:'var(--muted)'
};

function renderLive(){
  const sum=document.getElementById('liveSummary');
  const body=document.getElementById('liveBody');
  const d=det();
  if(!d){ sum.innerHTML=''; body.innerHTML='<p class="note">No data for this date yet.</p>'; return; }

  const rows=liveRows();
  const n={ok:0,notselling:0,'sold-not-sent':0,'unsold-nosend':0,nodata:0};
  rows.forEach(r=>n[r.state]++);
  const loaded=!!d.salesLoaded;

  if(!loaded){
    sum.innerHTML=`<p class="note" style="color:var(--warning)"><b>No sales file loaded for ${esc(date)}.</b>
      Everything below is the indent side only — upload a sales export for this date and the flags switch on.
      Until then nothing is marked "not selling", because no sales data is not the same as no sales.</p>`;
  } else {
    const pills=[
      ['Selling', n.ok, 'var(--good)'],
      ['Indented, not selling', n.notselling, 'var(--critical)'],
      ['Sold without a dispatch', n['sold-not-sent'], 'var(--warning)'],
      ['Nothing sent or sold', n['unsold-nosend'], 'var(--muted)']
    ].filter(p=>p[1]>0);
    sum.innerHTML=`<div class="kv">${pills.map(([l,v,c])=>
      `<span class="pill"><b style="color:${c}">${v}</b> ${l}</span>`).join('')}
      <span class="pill">${rows.length} store line${rows.length===1?'':'s'} indented</span></div>`;
  }

  if(liveView==='grid'){ renderGrid(body, rows); return; }

  let show = liveView==='flag' ? rows.filter(r=>r.state==='notselling') : rows;
  show=show.slice().sort((a,b)=> b.sent-a.sent || a.item.localeCompare(b.item));

  if(!show.length){
    body.innerHTML = liveView==='flag'
      ? (loaded ? '<p class="note" style="color:var(--good)">Nothing flagged — every store that was sent stock sold at least one unit.</p>'
                : '<p class="note">Nothing to flag without a sales file for this date.</p>')
      : '<p class="note">No lines in this scope.</p>';
    return;
  }
  body.innerHTML=`<div style="overflow-x:auto;margin-top:12px"><table><thead><tr>
    <th>Item</th><th>Range</th><th>Store</th><th>IO number</th>
    <th class="n">Indented</th><th class="n">Sent</th><th class="n">Sold</th><th>Status</th>
    </tr></thead><tbody>${show.map(r=>`<tr>
      <td><b>${esc(r.item)}</b></td>
      <td style="font-size:12.5px;color:var(--text-secondary);white-space:nowrap">${esc(r.grp)}</td>
      <td style="white-space:nowrap">${esc(r.pod)}</td>
      <td class="io">${ioTags(r.io)}</td>
      <td class="n">${fmt(r.ord)}</td><td class="n">${fmt(r.sent)}</td>
      <td class="n">${r.sold==null?dashCell:`<b>${fmt(r.sold)}</b>`}</td>
      <td><span class="pill" style="color:${STATE_COLOR[r.state]}">${STATE_LABEL[r.state]}</span></td>
    </tr>`).join('')}</tbody></table></div>
    <p class="foothint">${show.length} line${show.length===1?'':'s'} shown${liveView==='flag'?' · biggest dispatch first, so the costliest ones are at the top':''}.</p>`;
  wireIOTags(body);
}

/** item x store grid — one cell per line, coloured by state */
function renderGrid(host, rows){
  if(!rows.length){ host.innerHTML='<p class="note">No lines in this scope.</p>'; return; }
  const items=[...new Set(rows.map(r=>r.item))].sort();
  const pods=[...new Set(rows.map(r=>r.pod))].sort();
  const cell=new Map();
  rows.forEach(r=>cell.set(r.item+'\u0000'+r.pod,r));
  const dot=r=>{
    if(!r) return `<span title="not indented here" style="color:var(--border)">·</span>`;
    const t=`${r.item} · ${r.pod}\nIndented ${r.ord} → sent ${r.sent}`
      + (r.sold!=null?` → sold ${r.sold}`:'')+`\n${STATE_LABEL[r.state]}`;
    const g={ok:'●',notselling:'▲','sold-not-sent':'◆','unsold-nosend':'○',nodata:'·'}[r.state];
    return `<span title="${esc(t)}" style="color:${STATE_COLOR[r.state]};font-size:13px">${g}</span>`;
  };
  host.innerHTML=`<div style="overflow-x:auto;margin-top:12px"><table style="font-size:12px">
    <thead><tr><th style="text-align:left">Item</th>${pods.map(p=>
      `<th style="writing-mode:vertical-rl;transform:rotate(180deg);white-space:nowrap;font-weight:500;padding:6px 2px">${esc(p)}</th>`).join('')}
      <th class="n">Stores</th></tr></thead>
    <tbody>${items.map(it=>{
      const line=pods.map(p=>cell.get(it+'\u0000'+p));
      const live=line.filter(r=>r&&r.state==='ok').length;
      const flag=line.filter(r=>r&&r.state==='notselling').length;
      return `<tr><td style="white-space:nowrap"><b>${esc(it)}</b></td>${
        line.map(r=>`<td style="text-align:center;padding:3px 2px">${dot(r)}</td>`).join('')}
        <td class="n" style="white-space:nowrap">${live} live${flag?` · <b style="color:var(--critical)">${flag} flagged</b>`:''}</td></tr>`;
    }).join('')}</tbody></table></div>
  <div class="kv" style="margin-top:10px">
    <span class="pill"><b style="color:var(--good)">●</b> selling</span>
    <span class="pill"><b style="color:var(--critical)">▲</b> indented, not selling</span>
    <span class="pill"><b style="color:var(--warning)">◆</b> sold without a dispatch</span>
    <span class="pill"><b style="color:var(--muted)">○</b> nothing sent or sold</span>
    <span class="pill"><b style="color:var(--border)">·</b> not indented at that store</span>
  </div>`;
}

/* ---------- unmatched sales names ---------- */
function renderAlias(){
  const sec=document.getElementById('secAlias'), body=document.getElementById('aliasBody');
  const un=(DATA.salesUnmatched||[]).filter(n=>!(DATA.salesAlias||{})[n]);
  if(!un.length){ sec.style.display='none'; body.innerHTML=''; return; }
  sec.style.display='';
  const tracked=[].concat(...GROUPS.map(g=>(DATA.registry[g]||[]).slice())).sort();
  body.innerHTML=`<div style="overflow-x:auto"><table><thead><tr>
      <th>Name in the sales file</th><th>Belongs to</th></tr></thead>
    <tbody>${un.slice(0,60).map(n=>`<tr>
      <td>${esc(n)}</td>
      <td><select class="ctl aliassel" data-n="${esc(n)}">
        <option value="">— ignore this name —</option>
        ${tracked.map(t=>`<option value="${esc(t)}">${esc(t)}</option>`).join('')}
      </select></td></tr>`).join('')}</tbody></table></div>
    ${un.length>60?`<p class="foothint">Showing 60 of ${un.length}.</p>`:''}`;
  body.querySelectorAll('.aliassel').forEach(s=>s.onchange=()=>{
    const from=s.dataset.n, to=s.value;
    DATA.salesAlias=DATA.salesAlias||{};
    if(to) DATA.salesAlias[from]=to; else delete DATA.salesAlias[from];
    logLine(to ? `Mapped sales name "${from}" → "${to}". Re-upload the sales file to apply it.`
               : `Ignoring sales name "${from}".`);
    markDirty();
  });
}

/* ---------- upload: Internal Order files and/or a sales file ---------- */
const uploadLog=document.getElementById('uploadLog');
function logLine(msg){
  uploadLog.style.display='block';
  uploadLog.textContent += (uploadLog.textContent?'\n':'') + msg;
  uploadLog.scrollTop=uploadLog.scrollHeight;
}

/** read just enough of a file to see its header row */
async function peekFields(file){
  const head=await file.slice(0, 64*1024).text();
  const rows=parseCSV(head.split(/\r?\n/).slice(0,3).join('\n'));
  return rows.length ? Object.keys(rows[0]) : [];
}

/** when files are picked, show the column mapper if one of them is a sales export */
document.getElementById('fileInput').addEventListener('change', async ()=>{
  const panel=document.getElementById('salesMap');
  const files=Array.from(document.getElementById('fileInput').files||[]);
  panel.style.display='none';
  for(const f of files){
    let fields=[];
    try{ fields=await peekFields(f); }catch(e){ continue; }
    if(!fields.length || looksLikeIO(fields)) continue;
    const guess=detectSalesCols(fields);
    const saved=DATA.salesCols||{};
    const use={date:saved.date&&fields.includes(saved.date)?saved.date:guess.date,
               pod: saved.pod &&fields.includes(saved.pod) ?saved.pod :guess.pod,
               item:saved.item&&fields.includes(saved.item)?saved.item:guess.item,
               qty: saved.qty &&fields.includes(saved.qty) ?saved.qty :guess.qty};
    const opts=k=>`<option value="">— none —</option>`+fields.map(f2=>
      `<option value="${esc(f2)}"${f2===use[k]?' selected':''}>${esc(f2)}</option>`).join('');
    document.getElementById('scDate').innerHTML=opts('date');
    document.getElementById('scPod').innerHTML=opts('pod');
    document.getElementById('scItem').innerHTML=opts('item');
    document.getElementById('scQty').innerHTML=opts('qty');
    document.getElementById('scPreview').textContent =
      `${f.name} — ${fields.length} columns found.`;
    panel.style.display='';
    break;
  }
});

function chosenSalesCols(){
  return {date:document.getElementById('scDate').value,
          pod: document.getElementById('scPod').value,
          item:document.getElementById('scItem').value,
          qty: document.getElementById('scQty').value};
}

document.getElementById('processBtn').onclick=async ()=>{
  const files=Array.from(document.getElementById('fileInput').files||[]);
  const overwrite=document.getElementById('overwriteChk').checked;
  uploadLog.textContent='';
  if(!files.length){ logLine('Pick at least one CSV file first.'); return; }
  const tracked=[].concat(...GROUPS.map(g=>DATA.registry[g]||[])).length;
  if(!tracked){ logLine('Nothing is in the tracked-items list. Add items at the bottom of the page first.'); return; }

  try{
    const byDate=new Map();
    let salesRows=[], sawSales=false;

    for(const file of files){
      let text;
      try{ text=await file.text(); }catch(e){ logLine(`  ✗ ${file.name}: ${e.message}`); continue; }
      let fields=[];
      try{ const probe=parseCSV(text.split(/\r?\n/).slice(0,3).join('\n'));
           fields=probe.length?Object.keys(probe[0]):[]; }catch(e){}

      if(fields.length && !looksLikeIO(fields)){
        // ---- sales export ----
        const cols=chosenSalesCols();
        const missing=['date','pod','item','qty'].filter(k=>!cols[k]);
        if(missing.length){
          logLine(`  ✗ ${file.name}: tell me which column holds ${missing.join(', ')} in the box above, then press Process again.`);
          continue;
        }
        logLine(`Reading sales file ${file.name}…`);
        const rows=loadSalesRows(text, file.name, cols);
        if(!rows.length){ logLine(`  ✗ no usable sales rows (check the Store and Item columns).`); continue; }
        const dates=[...new Set(rows.map(r=>r.date).filter(Boolean))].sort();
        logLine(`  → ${rows.length} rows · dates ${dates.slice(0,4).join(', ')}${dates.length>4?' …':''}`);
        salesRows=salesRows.concat(rows); sawSales=true;
        DATA.salesCols=cols;
        continue;
      }

      // ---- internal order export ----
      logLine(`Parsing ${file.name}…`);
      let rows;
      try{ rows=loadExportRows(text, file.name); }
      catch(e){ logLine(`  ✗ ${e.message}`); continue; }
      if(!rows.length){ logLine(`  ✗ ${file.name}: no usable rows`); continue; }
      const D=discoverReportDate(rows);
      logLine(`  → report date ${D} · ${rows.length} rows`);
      const arr=byDate.get(D)||[]; arr.push(rows); byDate.set(D,arr);
    }

    let added=false, last=null;
    for(const [D,arrs] of byDate){
      if(DATA.dates.indexOf(D)>=0 && !overwrite){
        logLine(`${D} is already in this file — skipping (tick "Overwrite" to replace it).`); continue;
      }
      logLine(`Building ${D}…`);
      try{
        const agg=buildDayAgg(D, arrs);
        if(!agg.items.length){
          logLine(`  ✗ ${D}: none of the tracked items appear on this date. Check the tracked-items list against the spellings in the file.`);
          continue;
        }
        mergeAggIntoData(agg);
        const byGrp=GROUPS.map(g=>{
          const it=agg.items.filter(i=>i.g===g); if(!it.length) return null;
          const go=it.reduce((a,i)=>a+i.o,0), gs=it.reduce((a,i)=>a+i.s,0);
          const sh=it.reduce((a,i)=>a+i.sh,0);
          return `${g} ${go?((gs/go)*100).toFixed(1):'—'}%${sh?` (${pr2(sh)} short)`:''}`;
        }).filter(Boolean).join(' · ');
        logLine(`  ✓ ${D} — ${agg.items.length} items, ${agg.pods.length} stores`);
        logLine(`      ${byGrp}`);
        added=true; last=D;
      }catch(e){ logLine(`  ✗ ${D}: ${e.message}`); }
    }

    if(sawSales){
      logLine('Matching sales against the tracked items…');
      const rep=attachSales(salesRows);
      DATA.salesUnmatched=[...new Set((DATA.salesUnmatched||[]).concat([...rep.unmatchedSales]))];
      Object.keys(rep.dates).forEach(D=>{
        const r=rep.dates[D];
        logLine(r.note ? `  • ${D}: ${r.note}` : `  ✓ ${D}: sales attached to ${r.applied} of ${r.items} tracked items`);
      });
      if(rep.noDate) logLine(`  ⚠ ${rep.noDate} sales rows had no readable date — check the Date column.`);
      if(rep.unmatchedPods.size) logLine(`  ⚠ store names not seen in the indent data: ${[...rep.unmatchedPods].slice(0,6).join(', ')}${rep.unmatchedPods.size>6?' …':''}`);
      if(rep.unmatchedSales.size) logLine(`  ⚠ ${rep.unmatchedSales.size} sales item name(s) did not match anything tracked — map them in "Sales names that didn't match" below, or their sales stay uncounted.`);
      added=true;
    }

    if(added){
      if(last) date=last;
      selPod=null; openItems.clear();
      initControls(); renderRegistry(); renderAlias(); renderAll(); markDirty();
      logLine('Done — the dashboard above is updated. Click "Download updated dashboard" to save this as your new file.');
    }
  }catch(e){ logLine(`Error: ${e.message||String(e)}`); }
};

document.getElementById('removeDateBtn').onclick=()=>{
  if(!date) return;
  const target=date;
  if(!confirm(`Remove ${target} from this dashboard?\n\nThis only changes the copy open in this tab — click "Download updated dashboard" afterwards to save it without that date.`)) return;
  DATA.dates=DATA.dates.filter(d=>d!==target);
  delete DATA.detail[target];
  date=DATA.dates[DATA.dates.length-1];
  selPod=null; openItems.clear();
  initControls(); renderAll(); markDirty();
  logLine(`Removed ${target}. Click "Download updated dashboard" to save this as your new file.`);
};

document.getElementById('downloadBtn').onclick=()=>{
  document.getElementById('dataTag').textContent=JSON.stringify(DATA);
  const html='<!doctype html>\n'+document.documentElement.outerHTML;
  const blob=new Blob([html],{type:'text/html'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  const latest=DATA.dates.length?DATA.dates[DATA.dates.length-1]:'empty';
  a.download=`Gourmet & Soups dashboard (through ${latest}).html`;
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(a.href);
};

/* live-view toggles */
['lvFlag','lvAll','lvGrid'].forEach((id,k)=>document.getElementById(id).onclick=()=>{
  liveView=['flag','all','grid'][k];
  ['lvFlag','lvAll','lvGrid'].forEach((x,j)=>press(x,j===k));
  renderLive();
});

initControls(); renderRegistry(); renderAlias(); renderAll(); markDirty();
(function(){ var el=document.getElementById('jsReady');
  if(el){ el.textContent='Dashboard ready.'; el.style.color='var(--good)'; } })();

</script>
