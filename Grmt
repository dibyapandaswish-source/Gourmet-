<script id="dataTag" type="application/json">{"dates":[],"detail":{},"registry":{"Gourmet":["Caprese Panini (Gourmet CK)","Chipotle Chicken Panini (Gourmet CK)","Chipotle Cottage Cheese Panini (Gourmet CK)","Pesto Chicken Panini (Gourmet CK)","English Breakfast (Gourmet CK)","Greek Platter Salad - Gourmet CK","Grilled Chicken Platter - Gourmet CK","Cottage Cheese with Roasted Vegetable - CK","Grilled Herbed Chicken with Roasted Vegetable - CK"],"Soups":["Truffle Cream Of Mushroom (V)","Cream Of Spinach (V)"],"Supporting":["Ciabatta Panini","Gourmet Sleeve"]},"catalog":[],"salesCols":{},"salesAlias":{},"salesUnmatched":[]}</script>
<script>
/* =====================================================================
   Gourmet & Soups — supply & sales
   Everything runs in this browser tab. No server, nothing uploaded.
   ===================================================================== */
(function(){ var el=document.getElementById('jsReady'); if(el){ el.textContent='Script loaded, building the page…'; } })();

const DATA = JSON.parse(document.getElementById('dataTag').textContent);
const GROUPS = ['Gourmet','Soups','Supporting'];
const GRP_COLOR = {Gourmet:'var(--s1)', Soups:'var(--s2)', Supporting:'var(--s3)'};

let date  = DATA.dates[DATA.dates.length-1];
// Range never blends Gourmet/Soups (portions) with Supporting (pcs) — a fill
// rate across different units of measure is a meaningless number.
let grp   = 'CORE';         // CORE (gourmet+soups) | Gourmet | Soups | Supporting
let store = 'ALL';
let podSort='short', itemFilter='all', query='', selPod=null;
let openItems = new Set();

const fmt = n => (Math.round(n*100)/100).toLocaleString('en-IN');
const pct = v => (v==null||isNaN(v)) ? '—' : (v*100).toFixed(1)+'%';
const esc = s => String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const rd2 = x => Math.round(x*100)/100;
const det = () => DATA.detail[date] || null;
const hasDetail = () => !!DATA.detail[date];
const oneStore = () => store !== 'ALL';
/** has any sales figure been loaded for this date yet? */
const hasSales = () => { const d=det(); return !!(d && d.items.some(i=>i.sold!=null)); };

const ICON = {
  good:'<svg viewBox="0 0 16 16" fill="currentColor"><path d="M6.2 11.4 3 8.2l1.1-1.1 2.1 2.1 5-5L12.3 5.3z"/></svg>',
  warning:'<svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.6 15 14H1zM7.2 6h1.6v4H7.2zm0 5h1.6v1.6H7.2z"/></svg>',
  critical:'<svg viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="7"/><path d="M7.2 4h1.6v5H7.2zm0 6h1.6v1.6H7.2z" fill="var(--surface-1)"/></svg>'};
const flagOf = f => f>=0.95?{k:'good',t:'OK'}:f>=0.85?{k:'warning',t:'Watch'}:{k:'critical',t:'Check'};
const chip = f => {const x=flagOf(f); return `<span class="chip" style="color:var(--${x.k})">${ICON[x.k]}${x.t}</span>`;};

/* ---------- which groups the current Range filter covers ---------- */
function activeGroups(){
  if(grp==='CORE') return ['Gourmet','Soups'];
  return [grp];
}
const grpLabel = () => grp==='CORE' ? 'Gourmet + Soups' : grp;

/** units of `i` sold at `pod`: 0 when sales are loaded but this store sold none,
    null only when there is genuinely no sales data for the date */
function soldAt(i,pod){
  const d=det();
  if(!d || !d.salesLoaded || i.sold==null) return null;
  return (i.soldBy && i.soldBy[pod]!=null) ? i.soldBy[pod] : 0;
}

/* ---------- item rows for the current date / range / store ---------- */
function itemsFor(){
  const d=det(); if(!d) return [];
  const ag=activeGroups();
  let rows=d.items.filter(i=>ag.indexOf(i.g)>=0);
  if(!oneStore()) return rows;
  const pi=d.pods.indexOf(store); if(pi<0) return [];
  const out=[];
  rows.forEach(i=>{
    const p=(i.pr||[]).find(x=>x[0]===pi); if(!p) return;
    const o=p[1], s=p[2], r=p[3];
    if(o<=0) return;
    const f=o?Math.round(s/o*10000)/10000:0;
    const rec={...i, o:rd2(o), s:rd2(s), r:rd2(r), sh:rd2(Math.max(o-s,0)), f,
               np:1, z:(s===0?1:0), pr:[p]};
    rec.sold = soldAt(i, store);
    out.push(rec);
  });
  out.sort((a,b)=>b.sh-a.sh);
  return out;
}

/* ---------- totals for the current scope ---------- */
function scopeTotals(){
  const rows=itemsFor();
  const a={ord:0,sent:0,recd:0,short:0,items:rows.length,sold:0,anySold:false,zeroLines:0,shortItems:0};
  rows.forEach(i=>{
    a.ord+=i.o; a.sent+=i.s; a.recd+=i.r; a.short+=i.sh;
    a.zeroLines+=i.z; if(i.f<0.995) a.shortItems++;
    if(i.sold!=null){ a.sold+=i.sold; a.anySold=true; }
  });
  a.pods = oneStore() ? 1 : new Set([].concat(...rows.map(i=>(i.pr||[]).map(p=>p[0])))).size;
  return a;
}

/* ---------- per-store rollup ---------- */
function podRows(){
  const d=det(); if(!d) return [];
  const m={};
  itemsFor().forEach(i=>(i.pr||[]).forEach(p=>{
    const pod=d.pods[p[0]];
    const x=m[pod]||(m[pod]={pod, ord:0,sent:0,recd:0,short:0,items:0,zero:0,sold:0,anySold:false});
    const o=p[1], s=p[2];
    if(o<=0) return;
    x.ord+=o; x.sent+=s; x.recd+=p[3]; x.short+=Math.max(o-s,0); x.items++;
    if(s===0) x.zero++;
    const sv=soldAt(i,pod); if(sv!=null){ x.sold+=sv; x.anySold=true; }
  }));
  return Object.values(m).filter(x=>x.ord>0).map(x=>({...x, fill:x.sent/x.ord}));
}

/* ---------- day-wise trend for the current scope ---------- */
function trendRows(){
  const ag=activeGroups();
  return DATA.dates.map(D=>{
    const dd=DATA.detail[D];
    if(!dd) return {date:D,ord:0,sent:0,short:0,has:false};
    let pi=-1;
    if(oneStore()){ pi=dd.pods.indexOf(store); if(pi<0) return {date:D,ord:0,sent:0,short:0,has:false}; }
    const a={date:D,ord:0,sent:0,short:0,has:true};
    dd.items.forEach(i=>{
      if(ag.indexOf(i.g)<0) return;
      if(pi<0){ a.ord+=i.o; a.sent+=i.s; a.short+=i.sh; }
      else {
        const p=(i.pr||[]).find(x=>x[0]===pi); if(!p||p[1]<=0) return;
        a.ord+=p[1]; a.sent+=p[2]; a.short+=Math.max(p[1]-p[2],0);
      }
    });
    return a;
  });
}

/* ---------- IO numbers (click to copy for a Shoptree search) ---------- */
function ioSplit(s){ return String(s||'').split(',').map(x=>x.trim()).filter(Boolean); }
function ioList(i){ const set=new Set(); (i.pr||[]).forEach(p=>ioSplit(p[4]).forEach(x=>set.add(x))); return [...set].sort(); }
const ioTag = io => `<span class="iotag" data-io="${esc(io)}" title="Click to copy">${esc(io)}</span>`;
const dashCell = '<span style="color:var(--muted)">—</span>';
function ioTags(s){ const l=ioSplit(s); return l.length ? l.map(ioTag).join(' ') : dashCell; }
function ioCell(i){
  const l=ioList(i); if(!l.length) return dashCell;
  if(l.length<=2) return l.map(ioTag).join(' ');
  return ioTag(l[0])+`<span class="iomore">+${l.length-1} more</span>`;
}
function copyFallback(txt,done){
  try{ const ta=document.createElement('textarea'); ta.value=txt;
    ta.style.position='fixed'; ta.style.opacity='0';
    document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); done();
  }catch(e){}
}
function copyIO(txt,el){
  const done=()=>{ const old=el.textContent; el.classList.add('ok'); el.textContent='copied ✓';
    setTimeout(()=>{ el.textContent=old; el.classList.remove('ok'); },900); };
  try{ if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(done,()=>copyFallback(txt,done)); return; } }catch(e){}
  copyFallback(txt,done);
}
function wireIOTags(root){
  root.querySelectorAll('.iotag').forEach(el=>{
    el.onclick=ev=>{ ev.stopPropagation(); copyIO(el.dataset.io,el); };
  });
}

