/* ---------- tiles ---------- */
function renderTiles(){
  const scope = (oneStore()?' · '+store:'') + ' · ' + grpLabel();
  document.getElementById('glanceH').textContent = date
    ? `At a glance — ${date}${scope}`
    : 'At a glance — no data yet, upload a file above';
  const host=document.getElementById('tiles'); host.innerHTML='';
  if(!hasDetail()){ host.innerHTML='<p class="note">Upload an Internal Order export above to populate this date.</p>'; return; }
  const a=scopeTotals();
  if(!a.items){ host.innerHTML=`<p class="note">Nothing tracked was indented in this scope on ${esc(date)}.</p>`; return; }
  const fill=a.ord?a.sent/a.ord:NaN;
  const tiles=[
    ['Fill rate',pct(fill),`${fmt(a.ord)} indented → ${fmt(a.sent)} sent`,fill],
    ['Short units',fmt(a.short),`${a.shortItems} items short · ${a.zeroLines} store-lines at zero`,null],
    ['Items indented',fmt(a.items),oneStore()?'this store only':`across ${a.pods} store${a.pods===1?'':'s'}`,null],
  ];
  if(a.anySold){
    const st=a.sent?a.sold/a.sent:NaN;
    tiles.push(['Sold',fmt(a.sold),`${pct(st)} of what was sent`,null]);
  } else {
    tiles.push(['Sent → Received gap',fmt(a.sent-a.recd),
      `${pct(a.sent?(a.sent-a.recd)/a.sent:NaN)} of what was dispatched`,null]);
  }
  const g=document.createElement('div'); g.className='tiles';
  g.innerHTML=tiles.map(([l,v,f,fl])=>`<div class="tile"><div class="lab">${l}</div><div class="val">${v}</div>
     <div class="foot">${fl!=null&&!isNaN(fl)?chip(fl)+' ':''}${f}</div></div>`).join('');
  host.appendChild(g);
}

