/* ---------- item table ---------- */
function itemRows(){
  let rows=itemsFor();
  if(itemFilter==='short') rows=rows.filter(i=>i.sh>0||i.f<0.995);
  if(itemFilter==='zero')  rows=rows.filter(i=>i.z>0);
  if(query){ const q=query.toLowerCase(); const d=det();
    rows=rows.filter(i=> i.i.toLowerCase().includes(q) || i.g.toLowerCase().includes(q)
      || (i.pr||[]).some(p=>d.pods[p[0]].toLowerCase().includes(q) || (p[4]||'').toLowerCase().includes(q)));
  }
  return rows.slice().sort((a,b)=>b.sh-a.sh || b.o-a.o);
}
function mini(i){
  if(!i.pr) return '';
  const rows=i.pr.slice().sort((a,b)=>(a[1]?a[2]/a[1]:9)-(b[1]?b[2]/b[1]:9)).slice(0,34);
  return `<span class="mini">${rows.map(p=>{
    const f=Math.min(p[1]?p[2]/p[1]:0,1.5), h=Math.max(Math.round(f/1.5*14),2);
    return `<i class="${p[2]===0?'z':''}" style="height:${h}px"></i>`;}).join('')}</span>`;
}
function renderItems(){
  const sales=hasSales();
  const cols=['Item','Range','IO number','Indented','Sent','Received','Short','Fill %']
    .concat(sales?['Sold','Sold ÷ sent']:[])
    .concat(['Stores','Zero','Spread']);
