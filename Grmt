/* ---------- tracked-items editor ---------- */
function renderRegistry(){
  const host=document.getElementById('registry');
  host.innerHTML = GROUPS.map(g=>{
    const list=(DATA.registry[g]||[]).slice().sort();
    return `<div style="margin-top:12px">
      <div class="city-h"><span>${esc(g)} <span style="color:var(--muted);font-weight:400">(${list.length})</span></span><span class="rule"></span></div>
      <div class="kv" style="margin-top:8px">${list.length?list.map(n=>
        `<span class="pill">${esc(n)} <a href="#" class="regdel" data-g="${esc(g)}" data-n="${esc(n)}"
           title="Stop tracking this item" style="color:var(--critical);text-decoration:none;font-weight:700;margin-left:4px">×</a></span>`
        ).join(''):'<span style="color:var(--muted);font-size:13px">Nothing tracked in this group.</span>'}</div>
    </div>`;
  }).join('');
  host.querySelectorAll('.regdel').forEach(a=>a.onclick=ev=>{
    ev.preventDefault();
    const g=a.dataset.g, n=a.dataset.n;
    DATA.registry[g]=(DATA.registry[g]||[]).filter(x=>x!==n);
    // Untracking also drops the item from every stored date. Adding needs a
    // re-upload (the raw numbers were never kept), but removing never does —
    // and leaving it on screen after you untracked it would just be confusing.
    let purged=0;
    DATA.dates.forEach(D=>{
      const dd=DATA.detail[D]; if(!dd) return;
      const before=dd.items.length;
      dd.items=dd.items.filter(i=>i.i!==n);
      purged+=before-dd.items.length;
    });
    if(oneStore()) refreshStoreOptions();
    renderRegistry(); renderAll(); markDirty();
    logLine(`Stopped tracking "${n}" (${g})`
      + (purged?` — also removed from ${purged} stored date${purged===1?'':'s'}.`:'.'));
  });

  const sel=document.getElementById('regGroup');
  if(sel && !sel.options.length) sel.innerHTML=GROUPS.map(g=>`<option value="${esc(g)}">${esc(g)}</option>`).join('');
  const cat=document.getElementById('regCatalog');
  const seen=(DATA.catalog||[]).slice().sort();
  if(cat) cat.innerHTML=seen.map(n=>`<option value="${esc(n)}"></option>`).join('');
  document.getElementById('regHint').textContent = seen.length
    ? `${seen.length} item names were seen in the last upload — start typing to pick one, or type any name exactly as Shoptree spells it.`
    : `Upload a file first and this box will suggest the item names found in it.`;
}
function addRegistryItem(){
  const g=document.getElementById('regGroup').value;
  const box=document.getElementById('regNew');
  const name=(box.value||'').trim();
  if(!name){ logLine('Type an item name first.'); return; }
  const all=[].concat(...GROUPS.map(x=>DATA.registry[x]||[]));
  if(all.indexOf(name)>=0){ logLine(`"${name}" is already tracked.`); return; }
  (DATA.registry[g]=DATA.registry[g]||[]).push(name);
  box.value='';
  renderRegistry(); renderAll(); markDirty();
  const known=(DATA.catalog||[]).indexOf(name)>=0;
  logLine(`Now tracking "${name}" under ${g}.`
    + (known?' Re-upload any past day with Overwrite ticked to backfill it.'
           :' ⚠ That name was not in the last upload — check the spelling against Shoptree, or it will never match.'));
}

