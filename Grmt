    let h=`<tr class="itemrow" data-k="${esc(key)}">
      <td><b>${esc(i.i)}</b><div style="font-size:11.5px;color:var(--muted)">${esc(i.u||'')}</div></td>
      <td style="font-size:12.5px;color:var(--text-secondary);white-space:nowrap">${esc(i.g)}</td>
      <td class="io">${ioCell(i)}</td>
      <td class="n">${fmt(i.o)}</td><td class="n">${fmt(i.s)}</td><td class="n">${fmt(i.r)}</td>
      <td class="n"><b>${fmt(i.sh)}</b></td><td class="n">${pct(i.f)}</td>`;
    if(sales) h+=`<td class="n">${i.sold!=null?fmt(i.sold):dashCell}</td><td class="n">${pct(sellThru)}</td>`;
    h+=`<td class="n">${i.np}</td>
      <td class="n">${i.z?`<span style="color:var(--critical);font-weight:650">${i.z}</span>`:'0'}</td>
      <td>${mini(i)}</td></tr>`;
    if(open&&i.pr) h+=i.pr.map(p=>{
      const pod=d.pods[p[0]];
      const sold=soldAt(i,pod);
      let r=`<tr class="podrow"><td>${esc(pod)}</td><td></td><td class="io">${ioTags(p[4])}</td>
        <td class="n">${fmt(p[1])}</td><td class="n">${fmt(p[2])}</td><td class="n">${fmt(p[3])}</td>
        <td class="n">${p[1]-p[2]>0?fmt(p[1]-p[2]):'—'}</td><td class="n">${pct(p[1]?p[2]/p[1]:null)}</td>`;
      if(sales) r+=`<td class="n">${sold!=null?fmt(sold):dashCell}</td><td class="n">${pct(sold!=null&&p[2]?sold/p[2]:null)}</td>`;
      return r+`<td colspan="3"></td></tr>`;
    }).join('');
    return h;
  }).join('');

  const shortCount=rows.filter(i=>i.sh>0).length;
  document.getElementById('itemcount').textContent =
    `${rows.length} item${rows.length===1?'':'s'} shown (${shortCount} short-supplied) · ${fmt(rows.reduce((a,b)=>a+b.sh,0))} gross short units`;
  tb.querySelectorAll('.itemrow').forEach(tr=>tr.onclick=()=>{
    const k=tr.dataset.k; openItems.has(k)?openItems.delete(k):openItems.add(k); renderItems(); });
